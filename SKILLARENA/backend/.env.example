PORT=5000

# Local dev (MongoDB installed on this PC — default)
MONGODB_URI=mongodb://127.0.0.1:27017/Skill-Arena

# Atlas production / cloud — Database → Connect → Drivers in Atlas dashboard
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/Skill-Arena?retryWrites=true&w=majority

JWT_SECRET=change-this-to-a-long-random-secret-in-production
# Short-lived access JWT (seconds). Refresh lifetime is separate.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
JWT_ISSUER=skillarena
JWT_AUDIENCE=skillarena-web
# Legacy name kept for compatibility docs; access TTL above is authoritative.
# JWT_EXPIRES_IN=15m

# Cookie flags (cross-site SPA → API typically needs SameSite=None + Secure)
# COOKIE_SAMESITE=None
# COOKIE_SECURE=1

# Comma-separated list of allowed frontend origins (Vercel + local dev)
CLIENT_URL=http://localhost:5173,https://skill-arena-smoky.vercel.app
# CLIENT_URLS=http://localhost:5173,https://your-app.vercel.app

# Optional SMTP for password-reset emails (token layer works without SMTP)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Skill Arena <noreply@example.com>
# Dev-only: returns reset token in API JSON. NEVER enable in production (startup will refuse).
# AUTH_DEBUG_RESET_TOKEN=1

PDF_SERVICE_URL=http://127.0.0.1:8001
# Shared secret for backend → PDF service (set the same value in pdf-service env)
# Required if PDF_SERVICE_HOST is not loopback. Prefer always setting in staging/production.
# PDF_SERVICE_SECRET=replace-with-a-long-random-string
# PDF_SERVICE_HOST=127.0.0.1
# PDF_SERVICE_PORT=8001
# PDF_SERVICE_REQUIRE_SECRET=1
# PDF_SERVICE_MAX_CONCURRENT=2
# PDF_SERVICE_MAX_BODY_BYTES=524288
# PDF_SERVICE_MAX_PDF_BYTES=5242880
# PDF_FETCH_TIMEOUT_MS=120000
# Production PDF service example (private network only — do not expose publicly):
# PDF_SERVICE_URL=http://pdf-service.internal:8001

# Admin bootstrap (required for npm run create-admin — password is never printed)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-long-unique-password
# ADMIN_NAME=Skill Arena Admin

# Optional server-wide Gemini fallback (users can also add their own keys in Profile)
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# GEMINI_API_KEYS=key-one,key-two,key-three
# OPENAI_API_KEY=  # optional; only used if a user saves their own ChatGPT key in Profile
# OPENAI_MODEL=gpt-4o-mini
# AI_KEYS_SECRET=optional-separate-secret-for-encrypting-user-api-keys

# Performance instrumentation (dev/staging)
# PERF_LOG=1
# PERF_MEASURE_TOKEN=
# PERF_MEASURE_BASE=http://127.0.0.1:5000/api

# Coding runner isolation (Phase 6B) — process worker defaults
# CODING_MAX_CONCURRENT=2
# CODING_WALL_TIMEOUT_MS=3000
# CODING_SCRIPT_TIMEOUT_MS=1000
# CODING_MAX_OLD_SPACE_MB=64
# CODING_MAX_STDOUT_BYTES=262144
